  "ocr_adapter_review": {
    "app_adapter": "app/src/main/java/com/musicsheets/app/importer/SheetOcr.java",
    "shared_support": [
      "MeterChangeDetector.java",
      "MeterOcrEvidence.java"
    ],
    "boundary": "Android ML Kit, Bitmap cleanup and raster reflow remain app adapters. Standalone callers can obtain bounded signature crops and following measure indices, apply the shared ink threshold, submit horizontally reflowed crop OCR to MeterOcrEvidence, and pass accepted readings through Annotations.meters. The standalone package does not bundle an OCR engine."
  },
  "piano_notation_review": {
    "app_commit": "edebae3824b8df22a455eabcdaf471192b404d29",
    "boundary": "Shared folio rejection, compact double-sharp recognition, and octave-clef numeral topology. Standalone Main and app playback both map the double-sharp token to two semitones. Android guide-cache format validation and version invalidation stay app-only. No source scores, phone logs, or private fixtures are distributed; new regressions use original generated geometry. Models and weights unchanged."
  },
  "tablature_adapter_review": {
    "reviewed_app_commit": "19ba8a8455b517c23c5aa87f54cfff6bcc1dbfff",
    "app_adapter": "app/src/main/java/com/musicsheets/app/pdf/TablatureOcr.java",
    "boundary": "Android ML Kit OCR remains an app adapter, now includes rhythm lanes. Shared TabNotation decodes explicit duration/rest words and external stems/beams; TabEffect carries numeric effect curves through existing articulation serialization. App OrnamentPerformance applies the shared pitch curve to sampled playback; standalone JSON exposes guitarEffect and MIDI export isolates bend channels. No model weights, private fixtures or external source code imported. Unsupported graphical bend curves, tab ties, tuplets and ambiguous half-note stems remain limitations; missing rhythm remains estimated."
  },
  "study_notation_review": {
    "reviewed_app_commit": "c4a48f86b8a2975bf9bc7af54cbc3d14cc3a0624",
    "boundary": "Original raster geometry for stopped-note plus fourth-touch artificial harmonics, with conservative diamond and stem evidence. App OmrMeasureAnalyzer and standalone SheetInterpreter invoke the same helper after octave marks. Flat signature recovery accepts ordered spine runs and does not trim a verified clef header as a barline. Only these OmrScoreInterpreter hunks were ported; its previously reported unrelated app drift remains visible. New tests use original generated glyphs. No score scans, library content, logs, model weights or external code are included."
  },
  "study_rhythm_review": {
    "reviewed_app_commit": "85ff84983ca51b825afdb86da0791695e2b72be6",
    "boundary": "Original generated regressions cover fused beam tips, staff-rule fringe, equal repeated implicit triplets, partial flat signatures and bare octave numerals with dotted spans. Shared helpers ported to the app; guide cache invalidation remains Android-only. OmrScoreInterpreter prior unrelated drift is retained, not hidden by a hash update. No score images, logs, private library or model weights included. These repairs are not a claim of complete score accuracy."
  },
  "natural_fringe_review": {
    "reviewed_app_commit": "e6b9fcabffdadc1520350471d2286bf5897bd811",
    "boundary": "Shared natural-glyph endpoint check permits only one extra fringe pixel beyond the usual spine tolerance when both endpoints have strong natural offsets. Existing asymmetric sharp regression retained; new original synthetic natural and sharp shapes added. Other OmrScoreInterpreter drift remains visible. No private score or model changes."
  }
}
